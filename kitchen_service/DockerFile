# kitchen_service/Dockerfile
FROM python:3.11-slim

WORKDIR /app

# Copy pyproject.toml AND kitchen_commons directory
COPY pyproject.toml /tmp/
COPY kitchen_commons/ /tmp/kitchen_commons/

# Install shared package
RUN cd /tmp && pip install --no-cache-dir . && rm -rf /tmp/kitchen_commons /tmp/pyproject.toml

# Install service dependencies
COPY kitchen_service/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy service code
COPY kitchen_service/ ./kitchen_service/

EXPOSE 7000

CMD ["uvicorn", "kitchen_service.KitchenServiceEntry:app", "--host", "0.0.0.0", "--port", "7000"]