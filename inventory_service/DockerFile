# inventory_service/Dockerfile
FROM python:3.11-slim

WORKDIR /app

# Copy pyproject.toml AND kitchen_commons directory
COPY pyproject.toml /tmp/
COPY kitchen_commons/ /tmp/kitchen_commons/

# Install shared package
RUN cd /tmp && pip install --no-cache-dir . && rm -rf /tmp/kitchen_commons /tmp/pyproject.toml

# Install service dependencies
COPY inventory_service/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy service code
COPY inventory_service/ ./inventory_service/

EXPOSE 8000

CMD ["uvicorn", "inventory_service.InventoryServiceEntry:app", "--host", "0.0.0.0", "--port", "8000"]